APP_NAME="Invoice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Where the Vue SPA runs. Links in emails (verification, password reset) point here.
JS_APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the "mysql" service in docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=invoice
DB_USERNAME=invoice
DB_PASSWORD=secret

# Sanctum SPA auth: the SPA's host:port must be listed here, and the session cookie must be
# shared between the SPA and the API (same "site": localhost:8080 <-> localhost:8000 is fine).
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends emails/SMS immediately. Use "database" + the queue container in production.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# MailDev (docker-compose "mail" service). View emails at http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local development only: accept any 2FA code.
TWO_FACTOR_SKIP=false

# SMS (2FA). In APP_ENV=local, SMS are not sent: App\Listeners\CaptureOutgoingSms writes them to
# storage/logs/laravel.log instead.
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# Social login (optional). Callback URLs must point at the API, e.g.
# http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/auth/facebook/callback"

VITE_APP_NAME="${APP_NAME}"
