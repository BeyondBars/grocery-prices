{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["./src/**/*", "env.d.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
